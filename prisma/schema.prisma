// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// USER
model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  phone    String?
  role     String  @default("user")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings                Booking[]
  memberships             UserMembership[]
  membershipRegistrations MembershipRegistration[]

  // relasi baru: dipakai untuk audit trail siapa yang approve/reject registrasi
  approvedRegistrations MembershipRegistration[] @relation("ApprovedBy")

  // relasi baru: admin yang membuat entry maintenance/event/blocked di Jadwal Lapangan
  createdSchedules CourtSchedule[] @relation("ScheduleCreatedBy")
}

// COURT
model Court {
  id          Int     @id @default(autoincrement())
  name        String
  type        String
  price       Int
  description String?
  image       String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  // relasi baru: entry maintenance/event/blocked untuk lapangan ini
  courtSchedules CourtSchedule[]
}

// BOOKING
model Booking {
  id          Int    @id @default(autoincrement())
  bookingCode String @unique

  startAt  DateTime
  endAt    DateTime
  duration Int

  courtPrice Int
  notes      String?
  status     BookingStatus @default(pending)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  Int
  courtId Int

  user    User     @relation(fields: [userId], references: [id])
  court   Court    @relation(fields: [courtId], references: [id])
  payment Payment?

  @@index([courtId, startAt, endAt])
  @@index([userId])
}

// PAYMENT CHANNEL
model PaymentChannel {
  id            Int                @id @default(autoincrement())
  name          String
  type          PaymentChannelType
  accountNumber String?
  accountName   String?
  qrImage       String?
  isActive      Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments      Payment[]
  registrations MembershipRegistration[]
}

// PAYMENT
model Payment {
  id               Int  @id @default(autoincrement())
  bookingId        Int  @unique
  paymentChannelId Int?
  promoId          Int?

  courtPrice  Int
  adminFee    Int @default(0)
  discount    Int @default(0)
  totalAmount Int

  status      PaymentStatus @default(pending)
  paidAt      DateTime?
  expiredAt   DateTime?
  confirmedAt DateTime?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking         @relation(fields: [bookingId], references: [id])
  channel PaymentChannel? @relation(fields: [paymentChannelId], references: [id])
  promo   Promo?          @relation(fields: [promoId], references: [id])

  proofs PaymentProof[]
}

// PAYMENT PROOF
model PaymentProof {
  id        Int    @id @default(autoincrement())
  paymentId Int
  image     String

  uploadedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])
}

// PROMO
model Promo {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  discount    Int
  isPercent   Boolean @default(false)
  maxDiscount Int?
  isActive    Boolean @default(true)

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model Membership {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  duration    Int              // masa berlaku dalam HARI (dipakai saat approve registration untuk hitung endDate)
  quotaLabel  String?          // label kuota, contoh: "4 Jam / Bulan". Null = tidak ditampilkan
  description String?
  benefits    Json             // array string, contoh: ["Harga lebih hemat", "Booking prioritas"]
  isPopular   Boolean  @default(false) // munculin badge "Paling Hemat" di frontend
  theme       String   @default("blue") // salah satu dari: slate | amber | blue | violet
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations   MembershipRegistration[]
  userMemberships UserMembership[]
}

model MembershipRegistration {
  id           Int               @id @default(autoincrement())
  userId       Int
  membershipId Int
  status       MembershipStatus  @default(pending) // pending -> verification -> active | rejected

  paymentChannelId Int?
  paymentMethod    PaymentChannelType?
  proofImageUrl    String?
  notes            String?

  // audit trail approve/reject
  approvedById Int?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  membership     Membership      @relation(fields: [membershipId], references: [id])
  paymentChannel PaymentChannel? @relation(fields: [paymentChannelId], references: [id])
  approvedBy     User?           @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([userId])
  @@index([membershipId])
  @@index([status])
}

model UserMembership {
  id           Int      @id @default(autoincrement())
  userId       Int
  membershipId Int
  startDate    DateTime @default(now())
  endDate      DateTime
  status       String   @default("active") // active | expired
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([userId])
  @@index([membershipId])
}

// VENUE
model Venue {
  id Int @id @default(autoincrement())

  name      String  @default("PUMA Badminton Hall")
  address   String?
  phone     String?
  email     String?
  openHour  String?
  closeHour String?
  logo      String?
  banner    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// COURT SCHEDULE — MODEL BARU
// Khusus nampung entry maintenance/event/blocked yang dibuat admin di halaman
// "Jadwal Lapangan". Sengaja dipisah dari Booking (bukan extend Booking),
// karena Booking murni transaksi user (userId wajib, ada Payment, dll),
// sedangkan entry di sini dibuat admin tanpa pelanggan/transaksi.
model CourtSchedule {
  id      Int          @id @default(autoincrement())
  courtId Int
  type    ScheduleType

  title String  // contoh: "Pembersihan Lapangan", "PUMA Cup", "Event Sponsor"
  notes String?

  startAt DateTime
  endAt   DateTime

  createdById Int // admin yang membuat entry ini

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court     Court @relation(fields: [courtId], references: [id])
  createdBy User  @relation("ScheduleCreatedBy", fields: [createdById], references: [id])

  @@index([courtId, startAt, endAt])
}

// ENUMS
enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PaymentStatus {
  pending
  uploaded
  confirmed
  rejected
  expired
  cash
}

// dipakai di MembershipRegistration.status (sebelumnya String biasa, sekarang enum asli)
enum MembershipStatus {
  pending
  verification
  active
  rejected
}

// dipakai untuk PaymentChannel.type DAN MembershipRegistration.paymentMethod
// nambahin "ewallet" karena di desain frontend ada 4 opsi: transfer, qris, e-wallet, tunai
enum PaymentChannelType {
  transfer
  qris
  ewallet
  cash
}

// ENUM BARU — dipakai di CourtSchedule.type
enum ScheduleType {
  maintenance
  event
  blocked
}

// BARU — dipakai di Notification.type
enum NotificationType {
  booking_new          // ke admin: ada booking baru masuk
  booking_confirmed    // ke user: booking-nya di-approve admin
  booking_cancelled    // ke user: booking-nya dibatalkan/ditolak
  booking_completed    // ke user: booking selesai
  membership_new       // ke admin: ada registrasi membership baru
  membership_active    // ke user: membership-nya diaktifkan admin
  membership_rejected  // ke user: registrasi membership ditolak
  schedule_new         // ke user/broadcast: ada maintenance/event baru
}

